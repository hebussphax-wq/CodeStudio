{
  "name": "codestudio",
  "displayName": "CodeStudio · Lokales Coden",
  "publisher": "tobyki",
  "version": "0.3.1",
  "description": "Ollama, geprüfte Diffs, Projekttests und Rückrollen direkt in Visual Studio Code.",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "license": "MIT",
  "activationEvents": [
    "onStartupFinished",
    "onView:codestudio.tasks"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "CodeStudio liest Projektdateien und führt freigegebene Projekttests aus."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codestudio",
          "title": "CodeStudio",
          "icon": "media/code.svg"
        }
      ]
    },
    "views": {
      "codestudio": [
        {
          "id": "codestudio.tasks",
          "name": "Lokales CodeStudio"
        }
      ]
    },
    "commands": [
      {
        "command": "codestudio.inspect",
        "title": "CodeStudio: Projekt und Editorkontext prüfen"
      },
      {
        "command": "codestudio.projectFile",
        "title": "CodeStudio: Projektdatei öffnen"
      },
      {
        "command": "codestudio.problems",
        "title": "CodeStudio: VS-Code-Probleme anzeigen"
      },
      {
        "command": "codestudio.runTests",
        "title": "CodeStudio: Projekttests jetzt ausführen"
      },
      {
        "command": "codestudio.generate",
        "title": "CodeStudio: Aufgabe planen und Diff erzeugen"
      },
      {
        "command": "codestudio.model",
        "title": "CodeStudio: Ollama-Modell wählen"
      },
      {
        "command": "codestudio.context",
        "title": "CodeStudio: Kontext einstellen"
      },
      {
        "command": "codestudio.tests",
        "title": "CodeStudio: Projekttests einstellen"
      },
      {
        "command": "codestudio.apply",
        "title": "CodeStudio: Geprüften Diff anwenden"
      },
      {
        "command": "codestudio.reject",
        "title": "CodeStudio: Vorschlag verwerfen"
      },
      {
        "command": "codestudio.openDiff",
        "title": "CodeStudio: Dateiänderung ansehen"
      },
      {
        "command": "codestudio.output",
        "title": "CodeStudio: Ablauf und Belege anzeigen"
      },
      {
        "command": "codestudio.autonomous",
        "title": "CodeStudio: Autonom entwickeln"
      },
      {
        "command": "codestudio.stop",
        "title": "CodeStudio: Autonomen Auftrag stoppen"
      },
      {
        "command": "codestudio.history",
        "title": "CodeStudio: Autonome Aufträge und QC-Belege"
      },
      {
        "command": "codestudio.provider",
        "title": "CodeStudio: Lokalen Ollama-Dienst auswählen"
      },
      {
        "command": "codestudio.workflow",
        "title": "CodeStudio: Modul-Workflow laden und prüfen"
      },
      {
        "command": "codestudio.graphics",
        "title": "CodeStudio: Grafik lokal mit ComfyUI erzeugen"
      },
      {
        "command": "codestudio.fallbackModels",
        "title": "CodeStudio: Lokale Ersatzmodelle wählen"
      },
      {
        "command": "codestudio.testProfiles",
        "title": "CodeStudio: Testprofile laden"
      },
      {
        "command": "codestudio.limits",
        "title": "CodeStudio: Laufgrenzen einstellen"
      }
    ],
    "configuration": {
      "title": "CodeStudio",
      "properties": {
        "codestudio.hostBinding": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Projektgebundene lokale Sitzung aus TobyKi. Wird ausschließlich beim Start aus TobyKi gesetzt."
        },
        "codestudio.model": {
          "type": "string",
          "default": "qwen2.5-coder:7b",
          "description": "Installiertes lokales Ollama-Modell.",
          "scope": "resource"
        },
        "codestudio.contextTokens": {
          "type": "number",
          "default": 16384,
          "minimum": 1024,
          "maximum": 262144,
          "description": "Kontextfenster; größere Werte benötigen mehr Modellspeicher.",
          "scope": "resource"
        },
        "codestudio.testCommand": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Testprogramm und Argumente. Ohne Tests bleibt das Ergebnis ungeprüft.",
          "scope": "resource"
        },
        "codestudio.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Absoluter Python-Pfad für die Quellentwicklung. Das Windows-Paket enthält seine Laufzeit."
        },
        "codestudio.autonomousSteps": {
          "type": "integer",
          "default": 6,
          "minimum": 1,
          "maximum": 12,
          "description": "Maximale Zahl autonom geplanter Implementierungsschritte.",
          "scope": "resource"
        },
        "codestudio.autonomousRepairs": {
          "type": "integer",
          "default": 3,
          "minimum": 0,
          "maximum": 8,
          "description": "Automatische Reparaturen nach Abarbeitung des Plans.",
          "scope": "resource"
        },
        "codestudio.autonomousMinutes": {
          "type": "integer",
          "default": 30,
          "minimum": 1,
          "maximum": 120,
          "description": "Zeitbudget für einen autonomen Auftrag.",
          "scope": "resource"
        },
        "codestudio.ollamaUrl": {
          "type": "string",
          "default": "http://127.0.0.1:11434",
          "scope": "resource",
          "description": "Lokaler Ollama-Dienst für vorhandene Modelle. Hostgebundene Projekte verwenden ihre Hostkonfiguration."
        },
        "codestudio.fallbackModels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "uniqueItems": true,
          "default": [],
          "scope": "resource",
          "description": "Geordnete vorhandene Ersatzmodelle desselben lokalen Ollama-Dienstes. Nach zwei fehlgeschlagenen Modultests wechseln; ursprüngliche Zeit-, Aufruf- und Reparaturgrenzen bleiben bestehen. Hostmodelle werden nicht umgangen."
        },
        "codestudio.testProfiles": {
          "type": "array",
          "default": [],
          "scope": "resource",
          "description": "Benannte Testprofile. Haben Vorrang vor testCommand; alle laufen in der Schlussprüfung.",
          "items": {
            "type": "object",
            "required": [
              "argv"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "argv": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "timeout_sec": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3600
              }
            }
          }
        },
        "codestudio.outputTokens": {
          "type": "integer",
          "default": 4096,
          "minimum": 256,
          "maximum": 32768,
          "scope": "resource",
          "description": "Maximale Ausgabetokens je lokalem Modellaufruf. Eingabe und Ausgabe benötigen gemeinsam ausreichend Kontext."
        },
        "codestudio.autonomousModelCalls": {
          "type": "integer",
          "default": 80,
          "minimum": 4,
          "maximum": 200,
          "scope": "resource",
          "description": "Gesamtbudget der Modellaufrufe einschließlich Reparaturen und Ersatzmodellen."
        }
      }
    }
  }
}
